HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated URLs or JSON array for production / local environments)
# Production example: CORS_ORIGINS=https://haritkranti.ai,https://app.haritkranti.ai,http://localhost:5500
CORS_ORIGINS=https://haritkranti.ai,https://app.haritkranti.ai,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# External API Credentials (Leave empty to automatically use Development Mock Services)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENWEATHER_API_KEY=
BHASHINI_API_KEY=
# Firebase Admin
# Local development: path to Firebase service account JSON
FIREBASE_CREDENTIALS_PATH=

# Production/Vercel: complete Firebase service account JSON as a single environment variable
FIREBASE_SERVICE_ACCOUNT_JSON=

