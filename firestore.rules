rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped scan records:
    // Only authenticated users can read, create, update, or delete their own scan records.
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other direct client reads and writes.
    // The backend FastAPI service uses the Firebase Admin SDK which operates with privileged server access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
