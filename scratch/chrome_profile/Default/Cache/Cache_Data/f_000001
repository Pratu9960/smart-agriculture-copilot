            </div>

            <div class="hero-right-col" aria-hidden="true">
              <div class="ai-radar-card">
                <svg class="radar-svg-canvas" viewBox="0 0 340 280">
                  <defs>
                    <radialGradient id="radarCenterGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#C4E86B" stop-opacity="0.5"/>
                      <stop offset="60%" stop-color="#A6CF3A" stop-opacity="0.18"/>
                      <stop offset="100%" stop-color="#A6CF3A" stop-opacity="0"/>
                    </radialGradient>
                  </defs>
