              <h1 class="hero-main-title" data-i18n="dashboard.heroTitle">Know what's <br>happening to your <br>crops.</h1>
              <p class="hero-description" data-i18n="dashboard.heroDesc">
                Instantly identify plant diseases, nutrient deficiencies, and pests with unparalleled accuracy. Our AI bridges traditional farming with cutting-edge data science.
              </p>
              <div class="hero-actions-row">
                <button type="button" class="btn-hero-primary" data-target="view-home">
                  <span data-i18n="dashboard.btnScan">Scan Your Crop →</span>
                </button>
                <button type="button" class="btn-hero-secondary" data-target="view-history">
                  <span data-i18n="dashboard.btnHistory">View Scan History</span>
                </button>
              </div>
              <div class="hero-stat-ticker" aria-label="Platform capabilities">
                <span class="ticker-item"><span class="ticker-icon">🌱</span> <span data-i18n="dashboard.tickerCrops">28 Crops</span></span>
                <span class="ticker-divider">•</span>
                <span class="ticker-item"><span class="ticker-icon">🔍</span> <span data-i18n="dashboard.tickerDiseases">82 Disease Records</span></span>
                <span class="ticker-divider">•</span>
                <span class="ticker-item"><span class="ticker-icon">🌐</span> <span data-i18n="dashboard.tickerMultilingual">Multilingual Support</span></span>
