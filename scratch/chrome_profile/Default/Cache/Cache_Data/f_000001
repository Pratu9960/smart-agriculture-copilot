          <p id="auth-subtitle">Sign in to continue to your crop intelligence workspace.</p>
          <div class="auth-language-control hidden">
            <select id="auth-language-select">
              <option value="en">English</option>
              <option value="mr">मराठी</option>
              <option value="hi">हिन्दी</option>
              <option value="ta">தமிழ்</option>
