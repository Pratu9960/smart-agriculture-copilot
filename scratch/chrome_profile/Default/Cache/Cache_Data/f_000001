<body>

  <!-- ========================================================================
       AUTHENTICATION SCREEN (Dual-Pane SaaS Layout)
       ======================================================================== -->
  <div id="auth-screen" class="auth-screen mode-login is-hidden" aria-label="Sign in to HaritKranti">
