        <!-- Integrated Auth Form (Sign In & Create Account) -->
        <form id="auth-form" class="auth-form mode-login" novalidate>
          <div id="auth-name-group" class="form-group">
            <label class="form-label" for="auth-name">Full Name</label>
            <input type="text" id="auth-name" class="form-input" placeholder="Full name" autocomplete="name">
          </div>

          <div id="auth-email-group" class="form-group">
            <label class="form-label" for="auth-email">Email Address</label>
            <input type="email" id="auth-email" class="form-input" placeholder="Email address" required autocomplete="email">
          </div>

          <div id="auth-password-group" class="form-group">
            <label class="form-label" for="auth-password">Password</label>
            <div class="password-field">
              <input type="password" id="auth-password" class="form-input" placeholder="Password" required autocomplete="current-password">
              <button type="button" id="btn-toggle-password" class="password-toggle" aria-label="Show password">Show</button>
            </div>
          </div>

          <div id="auth-confirm-group" class="form-group">
            <label class="form-label" for="auth-confirm-password">Confirm Password</label>
