            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
        <span>HaritKranti</span>
      </div>

      <div class="auth-visual-copy">
        <span class="auth-overline" data-i18n="auth.visualOverline">AGRICULTURAL INTELLIGENCE FOR EVERY GROWING SEASON</span>
        <h1 data-i18n="auth.visualTitle">Smarter decisions.<br>Healthier crops.</h1>
        <p data-i18n="auth.visualBody">AI-powered crop diagnosis, weather insights, mandi prices, and verified agricultural guidance — all in one workspace.</p>

        <!-- Feature Highlights -->
        <div class="auth-feature-list">
          <div class="auth-feature-card">
            <div class="auth-feature-icon">🌱</div>
            <div class="auth-feature-text">
              <strong>AI Crop Diagnosis</strong>
              <p>Identify crop diseases and get actionable treatment guidance.</p>
            </div>
          </div>
          <div class="auth-feature-card">
            <div class="auth-feature-icon">☁</div>
            <div class="auth-feature-text">
              <strong>Smart Weather Insights</strong>
              <p>Get weather-based irrigation and farming recommendations.</p>
            </div>
          </div>
          <div class="auth-feature-card">
            <div class="auth-feature-icon">📈</div>
            <div class="auth-feature-text">
              <strong>Market & Scheme Intelligence</strong>
              <p>Track mandi prices and discover relevant government schemes.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="auth-trust-line">
        <span><span class="trust-dot"></span> Secure Workspace</span>
        <span><span class="trust-dot"></span> AI-Powered Insights</span>
        <span><span class="trust-dot"></span> Online + Offline Ready</span>
      </div>
    </div>

    <div class="auth-panel">
      <div class="auth-panel-inner">
        <div class="mobile-auth-brand">
          <div class="brand-logo-icon">
            <svg viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
            </svg>
