              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span id="btn-google-text" data-i18n="auth.continueWithGoogle">Continue with Google</span>
          </button>

          <p class="auth-switch-copy">
            <span id="auth-switch-copy">Don't have an account? </span>
            <button type="button" id="auth-switch-link" class="link-button">Create account</button>
          </p>
